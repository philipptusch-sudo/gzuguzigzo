# ---------------------------------------------------------------------------
# Kofferwerk Auenfels -- Beispielkonfiguration
#
# Kopiere diese Datei nach .env.local (lokal) bzw. trage die Werte in der
# Hostingumgebung ein. .env.local ist per .gitignore ausgeschlossen.
#
# Es gehören KEINE echten Betreiberdaten in dieses Repository.
# ---------------------------------------------------------------------------

# --- Kill-Switch -----------------------------------------------------------
# "false" leitet saemtliche Shoprouten sofort auf /experiment um.
# Ohne Codeaenderung ueber die Hostingumgebung umschaltbar.
SITE_ENABLED=true

# --- Versuchsvariante ------------------------------------------------------
# control | closure-story | missing-information | combined
# Wird zum Buildzeitpunkt fixiert und darf waehrend eines laufenden Tests
# nicht gewechselt werden.
NEXT_PUBLIC_EXPERIMENT_VARIANT=combined

# --- Reale Projektverantwortliche (Pflicht) --------------------------------
# Diese Angaben erscheinen ausschliesslich auf /experiment.
# Ohne sie schlaegt der Produktionsbuild fehl.
REAL_OPERATOR_NAME="Vorname Nachname"
REAL_OPERATOR_LEGAL_FORM="Einzelunternehmen"
REAL_OPERATOR_ADDRESS="Musterstrasse 1, 12345 Musterstadt"
REAL_OPERATOR_EMAIL="projekt@example.org"
REAL_PROJECT_DESCRIPTION="Journalistisches Verbraucherschutzexperiment zur Pruefpraxis von Werbeplattformen und Fakeshop-Erkennung."

# --- Optional --------------------------------------------------------------
# Pressekontakt; faellt auf REAL_OPERATOR_EMAIL zurueck, wenn nicht gesetzt.
REAL_PRESS_EMAIL="presse@example.org"
# Link zum spaeteren Untersuchungsbericht; bleibt bis zur Veroeffentlichung leer.
REAL_REPORT_URL=""
